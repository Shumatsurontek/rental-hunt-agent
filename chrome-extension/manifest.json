{
  "manifest_version": 3,
  "name": "Rental Hunt Agent",
  "version": "0.3.0",
  "description": "Operate and debug one deployed Rental Hunt Agent from a Chrome side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "notifications", "sidePanel", "storage"],
  "host_permissions": ["https://*.seloger.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Rental Hunt Agent",
    "default_icon": "icons/rental-hunt-128.png"
  },
  "icons": {
    "128": "icons/rental-hunt-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.seloger.com/*"],
      "js": ["content-capture.js"],
      "run_at": "document_idle"
    }
  ]
}
