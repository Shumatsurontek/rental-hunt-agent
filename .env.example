ADMIN_API_TOKEN=replace-with-a-long-random-token
DATABASE_URL=postgresql+psycopg://rental_hunt:rental_hunt@postgres:5432/rental_hunt

# Select exactly one model provider. GPT-5.6 Luna is the default deployment model.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-5.6-luna
MODEL_BASE_URL=
OPENAI_API_KEY=

# Optional end-to-end traces. Set both to enable @traceable roots and nested LangChain spans.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rental-hunt-agent
# Only needed for an organization-scoped LangSmith API key.
LANGSMITH_WORKSPACE_ID=

LOG_LEVEL=INFO
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_USER_DATA_DIR=/data/browser
DEBUG_ARTIFACT_DIR=/data/debug
# Chrome mode avoids container anti-bot blocks; use playwright only when headless access succeeds.
SOURCE_MODE=chrome_extension

POSTGRES_DB=rental_hunt
POSTGRES_USER=rental_hunt
POSTGRES_PASSWORD=rental_hunt
